# LifeVault Backend Environment Configuration Example
# Copy this file to .env and fill in your actual local configuration values.

NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/lifevault
JWT_SECRET=your_jwt_access_token_secret_min_64_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_min_64_chars_long
JWT_REFRESH_EXPIRES_IN=30d
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,image/jpg
UPLOAD_DIR=uploads
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=120000
CORS_ORIGIN=http://localhost:4200
LOG_LEVEL=debug

# Email Configuration (Gmail SMTP - Port 587 STARTTLS)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=LifeVault Reminders <your-email@gmail.com>

# Storage Provider Configuration ('local' for dev, 'b2' for Backblaze B2 cloud storage)
STORAGE_PROVIDER=local
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET_NAME=lifevault-documents
B2_KEY_ID=your_b2_key_id_here
B2_APPLICATION_KEY=your_b2_application_key_here

